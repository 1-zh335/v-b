[
  {
    "name": "示例书源（导入后请改成真实站点）",
    "site": "https://www.example-novel.com/",
    "group": "自定义",
    "enabled": true,
    "audio": false,
    "weight": 10,
    "params": {
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
    },
    "search": {
      "params": {
        "url": "https://www.example-novel.com/search.php?keyword={{keyword}}&page={{page}}",
        "method": "GET",
        "charset": "UTF-8",
        "dynamicDelayTime": 500
      },
      "list": "//div[@class=\"book-item\"]",
      "detail": {
        "url": "///h3/a/@href",
        "title": "///h3/a/text()",
        "author": {
          "rule": "///p[@class=\"author\"]/text()",
          "replace": [
            "作者：##"
          ]
        }
      }
    },
    "detail": {},
    "toc": {
      "list": "//div[@id=\"list\"]/dl/dd",
      "name": "///a/text()",
      "url": "///a/@href",
      "filter": true,
      "reverse": false,
      "autoNext": false,
      "enableNext": false
    },
    "content": {
      "content": "//div[@id=\"content\"]/text()",
      "enableNext": false,
      "next": "xpath://a[text()~='.*?下[一]{0,1}[页节].*']/@href"
    }
  }
]